{
  "name": "benchflow",
  "version": "0.1.0",
  "description": "BenchFlow - PXE 任务编排桌面客户端",
  "author": "pyz",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "vite && electron .",
    "electron:build": "vue-tsc --noEmit && vite build && electron-builder",
    "electron:build:win": "vue-tsc --noEmit && vite build && electron-builder --win",
    "electron:build:mac": "vue-tsc --noEmit && vite build && electron-builder --mac",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "element-plus": "^2.7.0",
    "@element-plus/icons-vue": "^2.3.1",
    "vue-draggable-plus": "^0.5.0",
    "ssh2": "^1.15.0",
    "node-ssh": "^13.1.0",
    "pinia": "^2.1.7"
  },
  "devDependencies": {
    "vite": "^5.3.0",
    "vue-tsc": "^2.0.0",
    "typescript": "^5.4.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "@types/ssh2": "^1.15.0",
    "@types/node": "^20.14.0"
  },
  "build": {
    "appId": "com.benchflow.app",
    "productName": "BenchFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    }
  }
}

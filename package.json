{
  "name": "benchflow",
  "version": "0.5.0",
  "description": "BenchFlow - PXE 任务编排桌面客户端",
  "author": "pyz",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "vite && electron .",
    "electron:build": "vue-tsc --noEmit && vite build && electron-builder",
    "electron:build:win": "vue-tsc --noEmit && vite build && electron-builder --win --x64 && npm run verify:win-package",
    "electron:build:mac": "vue-tsc --noEmit && vite build && electron-builder --mac",
    "typecheck": "vue-tsc --noEmit",
    "verify:win-package": "node scripts/verify-win-package.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.7.0",
    "node-ssh": "^13.1.0",
    "pinia": "^2.1.7",
    "ssh2": "^1.15.0",
    "vue": "^3.4.0",
    "vue-draggable-plus": "^0.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^20.14.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vue-tsc": "^2.0.0"
  },
  "build": {
    "appId": "com.benchflow.app",
    "productName": "BenchFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/ssh2/**/*",
      "node_modules/ssh2-streams/**/*",
      "node_modules/node-ssh/**/*",
      "!**/*.node"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "allowElevation": true,
      "include": "build/installer.nsh"
    }
  }
}
